# Local development only. Keep real credentials in the ignored backend/.env or environment.
POSTGRESQL_CONNECTION=jdbc:postgresql://localhost:5432/webchat
POSTGRESQL_USERNAME=webchat
POSTGRESQL_PASSWORD=local-dev-password
FLYWAY_ENABLED=true
POSTGRES_DB=webchat
POSTGRES_USER=webchat

AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=ap-southeast-1
